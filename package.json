{
  "name": "random-gallery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "api": "cd server && go run ./cmd/api",
    "test:backend": "cd server && go test ./...",
    "check:backend": "cd server && go vet ./... && go test -race ./... && CGO_ENABLED=0 go build -o /tmp/random-gallery-api ./cmd/api",
    "test:accounts": "node tests/deployment/run-account-tests.mjs",
    "verify": "npm run typecheck && npm test && npm run check:backend && npm run build"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "overrides": {
    "nanoid": "3.3.19"
  }
}
